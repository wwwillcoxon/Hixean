' Un ARRAY[T] con Map, Filter y Fold.
'
'   Antes un ARRAY no era un ITER: habia que escribir el bucle con Len y At, y
'   encima no se podia encadenar nada encima. Ahora el ARRAY se convierte en
'   iterador con hx_iter_darr y a partir de ahi.Map y Filter se encadenan igual que
'   sobre un Rango. Fold es un bucle que produce un valor, no una secuencia.

DIM a AS ARRAY[INT]
a.Push(1)
a.Push(2)
a.Push(3)
a.Push(4)
a.Push(5)

' Map que conserva el tipo
FOR x IN a.Map(FUNC(n AS INT) AS INT
  RETURN n * 2
END FUNC)
  PRINT x
NEXT
PRINT "---"

' Map que lo cambia
FOR s IN a.Map(FUNC(n AS INT) AS STRING
  RETURN "n" ++ n.ToString()
END FUNC)
  PRINT s
NEXT
PRINT "---"

' Filter, con captura: la lambda lee una variable de su alrededor
DIM corte AS INT = 3
FOR y IN a.Filter(FUNC(n AS INT) AS BOOL
  RETURN n > corte
END FUNC)
  PRINT y
NEXT
PRINT "---"

' Fold: el acumulador delante, el elemento detras
FUNCTION Suma(acc AS INT, n AS INT) AS INT
  RETURN acc + n
END FUNCTION
FUNCTION Cuenta(acc AS INT, n AS INT) AS INT
  RETURN acc + 1
END FUNCTION
FUNCTION Maximo(acc AS INT, n AS INT) AS INT
  IF n > acc THEN RETURN n
  RETURN acc
END FUNCTION
PRINT a.Fold(0, Suma)
PRINT a.Fold(0, Maximo)
PRINT "---"

' Fold con un acumulador de otro tipo
FUNCTION Concat(acc AS STRING, n AS INT) AS STRING
  RETURN acc ++ n.ToString()
END FUNCTION
PRINT a.Fold("", Concat)
PRINT "---"

' un ARRAY vacio: Fold devuelve el inicial y los iteradores no dan nada
DIM vacio AS ARRAY[INT]
FUNCTION Uno(acc AS INT, n AS INT) AS INT
  RETURN acc + 1
END FUNCTION
PRINT vacio.Fold(99, Uno)
' un ARRAY vacio no produce nada en un iterador
DIM cuantos AS INT = 0
FOR z IN vacio.Filter(FUNC(n AS INT) AS BOOL
  RETURN TRUE
END FUNC)
  cuantos = cuantos + 1
NEXT
PRINT cuantos
PRINT "---"

' un ARRAY de cadenas
DIM nombres AS ARRAY[STRING]
nombres.Push("ana")
nombres.Push("beto")
nombres.Push("carla")
FOR m IN nombres.Map(FUNC(n AS STRING) AS STRING
  RETURN n.Upper()
END FUNC)
  PRINT m
NEXT
' Len() devuelve I64 y no se suma a un INT sin decir cual de los dos quieres. Es
'   lo correcto: unaconversiones explicita dice cual es, y un 0 a la derecha por
'   sorpresa es peor que un error de tipos aqui.
PRINT "---"

' Una FUNCTION de nivel superior NO captura, solo las lambdas. Esto no es un fallo:
'   el alcance de una FUNCTION es su propia unidad, y lo de fuera se le pasa por
'   parametro. Para usar un valor de fuera hace falta una lambda, que es justo lo
'   que hace el FILTER de mas arriba.

' Fold con una lambda que captura. El bloque se declara antes de la sentencia,
'   porque un Fold es una expresion y en C no se puede declarar una estructura
'   dentro de una expresion. Sin esto el tercer argumento de la lambda se quedaba
'   sin nada y el programa reventaba.
DIM extra AS INT = 2
DIM con_corte AS INT = a.Fold(0, FUNC(acc AS INT, n AS INT) AS INT
  RETURN acc + n + extra
END FUNC)
PRINT con_corte
PRINT "---"

' Lo mismo desde dentro de una FUNCTION, donde lo natural es un RETURN
FUNCTION FoldSuma(ar AS ARRAY[INT], extra AS INT) AS INT
  RETURN ar.Fold(0, FUNC(acc AS INT, n AS INT) AS INT
    RETURN acc + n + extra
  END FUNC)
END FUNCTION
PRINT FoldSuma(a, extra)
PRINT "---"

' Dos Folds con el mismo par (acumulador, elemento): uno con lambda que captura y
'   otro sin ella. Son dos firmas distintas y por tanto dos ayudantes; si se
'   compartieran, el que no captura tendria que pasar un argumento de mas y el que
'   captura leeria el bloque por donde le --
IF a.Fold(0, FUNC(acc AS INT, n AS INT) AS INT
  RETURN acc + n
END FUNC) > 5 THEN
  PRINT "la suma pasa de cinco"
END IF
DIM i AS INT = 0
WHILE i < a.Fold(0, FUNC(acc AS INT, n AS INT) AS INT
        RETURN acc + n + extra
      END FUNC)
  i = i + 1
END WHILE
PRINT i

' Encadenar sobre el ARRAY, que es lo que el ARRAY convierte en iterador para poder
'   hacer. Antes solo funcionaba el primer verbo: la cadena de iteradores no conocia
'   «MapD» y «FilterD», que son los nombres propios de un ARRAY, y le pedia un
'   ayudante para un elemento que no conocia —«hx_iter_filter_u», con la u de
'   desconocido—. Este caso estaba escrito en la cabecera de este fichero y nadie lo
'   habia probado.
FOR p IN a.Map(FUNC(n AS INT) AS INT
  RETURN n * 10
END FUNC).Filter(FUNC(n AS INT) AS BOOL
  RETURN n >= 40
END FUNC)
  PRINT p
NEXT
PRINT "---"

' tres verbos y un Take al final
DIM total AS INT = 0
FOR q IN a.Map(FUNC(n AS INT) AS INT
  RETURN n + 1
END FUNC).Filter(FUNC(n AS INT) AS BOOL
  RETURN n MOD 2 == 0
END FUNC).Take(2)
  total = total + q
NEXT
PRINT total
PRINT "---"

' y con una lambda que capture en medio de la cadena
FOR r IN a.Map(FUNC(n AS INT) AS INT
  RETURN n * extra
END FUNC).Filter(FUNC(n AS INT) AS BOOL
  RETURN n >= 6
END FUNC)
  PRINT r
NEXT
