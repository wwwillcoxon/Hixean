"VEC2, VEC3 y VEC4: los tres vectores que se pueden escribir"
DIM a AS VEC3 = (1.0, 2.0, 3.0)
DIM b AS VEC3 = (4.0, 5.0, 6.0)
DIM c AS VEC2 = (1.0, 2.0)
DIM v AS VEC4 = (1.0, 2.0, 3.0, 4.0)

"un vector sin valor inicial es el vector cero"
DIM cero AS VEC3
PRINT cero

"se imprimen como sus componentes"
PRINT a
PRINT c
PRINT v

"producto escalar: 1*4 + 2*5 + 3*6"
PRINT a.DOT(b)
"producto vectorial, que no es conmutativo"
PRINT a.CROSS(b)
"la longitud de verdad, no la longitud al cuadrado"
PRINT a.LEN()
"y el mismo numero en la forma libre, que es la de la tabla"
PRINT DOT(a, b)
PRINT LEN(a)

"suma, resta y escala"
PRINT a.ADD(b)
PRINT a.SUB(b)
PRINT a.SCALE(2.0)

"unidad: normalizar divide por la longitud, que da 1"
PRINT a.NORMALIZED().LEN()

"componentes con nombre y swizzle: a.zy es (a.z, a.y)"
PRINT a.x
PRINT a.zy
PRINT v.w

"los vectores son valores, no punteros: copian"
DIM copia AS VEC3 = a
PRINT copia