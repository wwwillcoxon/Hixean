"control: IF/WHILE/FOR/BREAK/CONTINUE/EXIT"
DIM total AS INT = 0
FOR i = 1 TO 5
  total = total + i
NEXT i
PRINT total

DIM j AS INT = 0
WHILE TRUE
  j = j + 1
  IF j >= 10 THEN EXIT WHILE
END WHILE
PRINT j

FOR k = 0 TO 20 STEP 2
  IF k = 6 THEN CONTINUE
  IF k >= 12 THEN BREAK
  PRINT k
NEXT k

DIM x AS INT = 5
IF x > 10 THEN
  PRINT "grande"
ELSEIF x > 3 THEN
  PRINT "mediano"
ELSE
  PRINT "chico"
END IF

IF x = 1 THEN PRINT "uno"
IF x <> 1 THEN PRINT "no uno"

FOR n = 10 TO 1 STEP -3
  PRINT n
NEXT n
