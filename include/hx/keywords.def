/* keyword id, lowercase spelling (matching is ASCII case-insensitive) */
/* el tokenkind resultante es TK_KW_<id> */

/* Solo palabras que el lenguaje usa de verdad. Las que estuvieron aqui sin uso
   (SHADER, VERTEX, UNIFORM, INPUT, OUTPUT, SHADOW, COMPUTE, FRAGMENT, IMPL,
   PUBLIC, DYN, COMPTIME, ASSERT, PURE, ENTRY) se quitaron en 0.2.0: eran
   palabras reservadas que no hacian nada, y reservan un nombre que un programa
   deberia poder usar. Eran 0.1.0 como maximo; la entrada ENTRY de los
   manifiestos .hxk no es esta keyword, la lee kit.c como texto. */

HX_KEYWORD(MODULE, "module")
HX_KEYWORD(END, "end")
HX_KEYWORD(IMPORT, "import")
HX_KEYWORD(AS, "as")
HX_KEYWORD(FUNCTION, "function")
HX_KEYWORD(RETURN, "return")
HX_KEYWORD(TYPE, "type")
HX_KEYWORD(TRAIT, "trait")
HX_KEYWORD(IF, "if")
HX_KEYWORD(THEN, "then")
HX_KEYWORD(ELSE, "else")
HX_KEYWORD(ELSEIF, "elseif")
HX_KEYWORD(WHILE, "while")
HX_KEYWORD(FOR, "for")
HX_KEYWORD(TO, "to")
HX_KEYWORD(IN, "in")
